# Copie para .env.observability (que está no .gitignore) e preencha.
# Depois rode: bash scripts/create-observability-secrets.sh

# New Relic -> API Keys -> chave do tipo "INGEST - LICENSE"
NEW_RELIC_LICENSE_KEY=

# PagerDuty -> Service "togglemaster" -> Integrations -> Events API V2 -> Integration Key
PAGERDUTY_INTEGRATION_KEY=

# Discord -> Editar canal -> Integrações -> Webhooks -> Copiar URL do webhook
DISCORD_WEBHOOK_URL=

# Senha do usuário admin do Grafana (invente uma)
GRAFANA_ADMIN_PASSWORD=

# Token que o Grafana usa para chamar o self-healing (se vazio, é gerado)
SELF_HEALING_TOKEN=
